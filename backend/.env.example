# Environment Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Use MongoDB Atlas for Production)
MONGO_URI=mongodb://localhost:27017/portfolio

# JWT Secret (MUST change to a strong random key in production)
JWT_SECRET=change_this_to_a_random_jwt_secret_in_production

# Admin Registration Key (For registering new admins via API without JWT token)
ADMIN_SECRET_KEY=change_this_to_your_private_admin_secret_key

# Seed Script Initial Admin Credentials (Read from private .env during seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_this_password

# Frontend Client URL (For CORS Security Restriction)
CLIENT_URL=http://localhost:5173